@startuml navigation

title Схема навигации между экранами

[*] --> Login : открытие приложения

state "Авторизация" as Login
state "Главная страница" as Dashboard
state "Переговорные комнаты" as RoomList
state "Просмотр переговорной комнаты" as RoomDetail
state "Создание бронирования" as BookingForm
state "Мои бронирования" as MyBookings

Login --> Dashboard : успешный вход

Dashboard --> RoomList : переговорные комнаты
Dashboard --> MyBookings : мои бронирования

RoomList --> RoomDetail : выбрать комнату
RoomList --> Dashboard : главная

RoomDetail --> RoomList : к списку комнат
RoomDetail --> BookingForm : забронировать

BookingForm --> MyBookings : создать бронирование
BookingForm --> RoomDetail : отмена

MyBookings --> Dashboard : главная

Dashboard --> Login : выход

@enduml